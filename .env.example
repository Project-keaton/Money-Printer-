# ForexBot configuration - copy this file to `.env` and fill it in.
# `.env` is git-ignored: never commit real API keys.

# ---------------------------------------------------------------------------
# Historical data pipeline (python -m data_pipeline)
# ---------------------------------------------------------------------------
# Provider: dukascopy (primary, no key) | oanda | twelvedata | alphavantage
DATA_PROVIDER=dukascopy
DATA_SYMBOL=EURUSD
# Timeframe: 1d (daily) or 1h (hourly)
DATA_TIMEFRAME=1d
# Leave DATA_START_DATE blank for "1 January, 10 years ago"; leave DATA_END_DATE blank for today.
DATA_START_DATE=2016-01-01
DATA_END_DATE=

# Output folders (relative to the project root)
DATA_DIR=data
# Daily only: also save a Monday-Friday dataset with Sunday candles folded into Monday
BUILD_WEEKDAY_DATASET=true
WEEKDAY_DATA_DIR=data/weekday
LOG_DIR=logs
REPORT_DIR=reports
LOG_LEVEL=INFO

# HTTP behaviour
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=5

# --- Dukascopy (no API key required) ---
DUKASCOPY_BASE_URL=https://datafeed.dukascopy.com/datafeed
# BID or ASK candles
DUKASCOPY_PRICE_SIDE=BID
# Seconds between requests. Increase (e.g. 2-5) if you receive HTTP 429 "Too Many Requests".
DUKASCOPY_REQUEST_INTERVAL=1.0

# --- OANDA (https://developer.oanda.com) ---
OANDA_API_KEY=
# practice or live
OANDA_ENVIRONMENT=practice

# --- Twelve Data (https://twelvedata.com) ---
TWELVE_DATA_API_KEY=

# --- Alpha Vantage (https://www.alphavantage.co) - daily data only ---
ALPHA_VANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Trading (future use)
# ---------------------------------------------------------------------------
BROKER_API_KEY=
BROKER_ACCOUNT_ID=
BROKER_ENVIRONMENT=practice
